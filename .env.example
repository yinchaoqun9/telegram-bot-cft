# Copy to .env and fill in your values

# OpenAI API key (Whisper + GPT fallback when Gemini fails or provider=openai)
OPENAI_API_KEY=sk-...

# Google Gemini (optional; when set, used first for transcribe + extract by default)
GEMINI_API_KEY=
# Model id, e.g. gemini-2.0-flash or gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# AI provider: gemini (default) or openai
AI_TRANSCRIBE_PROVIDER=gemini
AI_EXTRACT_PROVIDER=gemini

# Local brand catalog (fuzzy match to canonical names; no extra LLM tokens)
# Default if unset: data/cat_food_brands.json relative to app root
# BRAND_MAP_PATH=/absolute/or/relative/path/to/brands.json
# rapidfuzz ratio 0-100; below threshold the spoken string is kept as-is
BRAND_MATCH_THRESHOLD=85

# Supabase project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHI...

# Optional
PORT=8000
ENV=development

# Reminder job (private chat) offsets in days (comma-separated)
REMINDER_OFFSETS_DAYS=7,3,1
