# Copy to .env and fill in your values

# OpenAI API key (gpt-transcribe + GPT extract fallback)
OPENAI_API_KEY=sk-...
# File transcription model (whisper-1 deprecated; shutdown 2027-02-26)
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Google Gemini (optional; used first for STT + extract by default)
GEMINI_API_KEY=
# Dedicated speech-to-text model (Interactions / generateContent Transcribe API)
# Fits Telegram completed voice notes: auto language (zh/en), custom brand vocab.
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# Inventory JSON extraction (must be a chat/flash model — NOT the STT model)
GEMINI_EXTRACT_MODEL=gemini-2.0-flash
# Legacy alias for extract model if GEMINI_EXTRACT_MODEL unset
# GEMINI_MODEL=gemini-2.0-flash

# AI provider preference: gemini (default) | openai | assemblyai
AI_TRANSCRIBE_PROVIDER=gemini
AI_EXTRACT_PROVIDER=gemini

# AssemblyAI (optional 3rd STT backup for completed files)
# Use universal-3-5-pro for pre-recorded Telegram notes.
# universal-3-6-pro is streaming/realtime only — do not use for file upload STT.
ASSEMBLYAI_API_KEY=
# Comma-separated priority list (default: universal-3-5-pro,universal-2)
# ASSEMBLYAI_SPEECH_MODELS=universal-3-5-pro,universal-2

# Local brand catalog (fuzzy match to canonical names; no extra LLM tokens)
# Default if unset: data/cat_food_brands.json relative to app root
# BRAND_MAP_PATH=/absolute/or/relative/path/to/brands.json
# rapidfuzz ratio 0-100; below threshold the spoken string is kept as-is (default 80)
BRAND_MATCH_THRESHOLD=80

# Optional: when fuzzy + transcript substring both miss the catalog, Google search + LLM
# Create a Programmable Search Engine + enable Custom Search JSON API in Google Cloud.
BRAND_WEB_SEARCH_ENABLED=0
GOOGLE_CSE_API_KEY=
# Search engine ID (cx) from https://programmablesearchengine.google.com/
GOOGLE_CSE_CX=
# BRAND_REFINE_OPENAI_MODEL=gpt-4o-mini

# Supabase project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHI...
# Username without @ — required for Login Widget on /dashboard
TELEGRAM_BOT_USERNAME=your_bot_username
# Public HTTPS origin (no trailing slash); shown in /start and used for BotFather /setdomain
# DASHBOARD_PUBLIC_URL=https://your-app.up.railway.app

# Optional
PORT=8000
ENV=development

# Daily digest (send_reminders.py): expiring within 7 days vs 8–REMINDER_MAX_DAYS
# Set TZ on the host (e.g. Railway cron service) so "today" matches your calendar.
REMINDER_MAX_DAYS=15
# Max inline "Used" buttons per digest (rest listed with id for /used <item_id>)
REMINDER_DIGEST_MAX_BUTTONS=18
